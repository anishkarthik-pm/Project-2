# Google Gemini API Configuration
GEMINI_API_KEY=your_key_here

# Email Configuration
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=alias@company.com
EMAIL_PASSWORD=your_app_password

# App Configuration (defaults to Groww)
# Change these to analyze any Google Play Store app
APP_PACKAGE_NAME=com.nextbillion.groww
APP_NAME=Groww
REVIEW_LANG=en
REVIEW_COUNTRY=in

# Optional: Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: Review Time Window (default: 10 weeks, range: 8-12)
WEEKS_LOOKBACK=10
